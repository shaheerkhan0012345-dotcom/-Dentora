{
  "name": "Teethly-whatsapp-service",
  "version": "1.0.0",
  "description": "Standalone Persistent WhatsApp Automation Service for Teethly Dental Clinic",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.cjs",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "pino": "^8.19.0",
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}

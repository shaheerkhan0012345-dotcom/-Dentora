# Teethly WhatsApp Service Environment Configuration

PORT=3001
NODE_ENV=production

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://dentora-alpha.vercel.app

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=dentora-d8633
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dentora-d8633.iam.gserviceaccount.com
# Provide the private key wrapped in quotes with actual \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Security Secret for Service-to-Service Requests (must match VITE_WHATSAPP_SERVICE_SECRET in frontend)
WHATSAPP_SERVICE_SECRET=teethly_secret_key_2026

# Default Clinic Context
DEFAULT_CLINIC_ID=clinic-flagship
DEFAULT_CLINIC_TIMEZONE=Asia/Karachi

# Puppeteer / Chromium path (set automatically in Docker on Railway)
# Leave blank on local; Docker sets this to /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

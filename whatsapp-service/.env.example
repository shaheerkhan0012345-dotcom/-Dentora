# Dentora WhatsApp Service Environment Configuration

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-dentora-frontend.vercel.app

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Provide the private key wrapped in quotes with actual line breaks or \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Security Secret for Service-to-Service Requests
WHATSAPP_SERVICE_SECRET=your-secure-internal-api-secret-key

# Default Clinic Context
DEFAULT_CLINIC_ID=clinic-flagship
DEFAULT_CLINIC_TIMEZONE=Asia/Karachi

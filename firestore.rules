rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has Admin role in Firestore
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Patients Collection & Subcollections
    match /patients/{patientDocId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();

      match /documents/{docId} {
        allow read, write: if true;
      }

      match /timeline/{itemId} {
        allow read, write: if true;
      }

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // Standalone Patient Documents
    match /patientDocuments/{docId} {
      allow read, write: if true;
    }

    // Patient Accounts (Portal Logins)
    match /patientAccounts/{accId} {
      allow read, write: if true;
    }

    // Online Bookings Collection (Public 24/7 Dental Visit Booking System)
    match /onlineBookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Appointments Collection (Clinic & Online Booked Appointments)
    match /appointments/{aptId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Queue Collection (Live Waiting Room)
    match /queue/{qId} {
      allow read, write: if true;
    }

    // Doctor Schedules Collection
    match /doctorSchedules/{docScheduleId} {
      allow read, write: if true;
    }

    // Doctor Profiles Collection
    match /doctorProfiles/{docId} {
      allow read, write: if true;
    }

    // Clinics Collection
    match /clinics/{clinicId} {
      allow read, write: if true;
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Leave Requests Collection
    match /leaveRequests/{leaveId} {
      allow read, write: if true;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Notifications Collection (SMS, WhatsApp, Practice Alerts)
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /notificationJobs/{jobId} {
      allow read, write: if true;
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Dental Charts Collection
    match /dentalCharts/{chartId} {
      allow read, write: if true;
    }

    // Treatments Collection
    match /treatments/{treatmentId} {
      allow read, write: if true;
    }

    // Clinical Notes Collection
    match /clinicalNotes/{noteId} {
      allow read, write: if true;
    }

    // Prescriptions Collection
    match /prescriptions/{rxId} {
      allow read, write: if true;
    }

    // Patient Timelines Collection
    match /patientTimelines/{timelineId} {
      allow read, write: if true;
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Inventory Collection
    match /inventory/{itemId} {
      allow read, write: if true;

      match /logs/{logId} {
        allow read, write: if true;
      }
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Messages Collection
    match /messages/{msgId} {
      allow read, write: if true;
    }

    // AI Copilot Collections
    match /aiChats/{chatId} {
      allow read, write: if true;
    }

    match /aiMessages/{msgId} {
      allow read, write: if true;
    }

    match /aiPrompts/{promptId} {
      allow read, write: if true;
    }

    match /aiSettings/{settingId} {
      allow read, write: if true;
    }

    match /aiLogs/{logId} {
      allow read, write: if true;
    }

    match /aiActions/{actionId} {
      allow read, write: if true;
    }

    match /whatsappLogs/{logId} {
      allow read, write: if true;
    }

    match /whatsappConnections/{connId} {
      allow read, write: if true;
    }

    match /aiAutomations/{autoId} {
      allow read, write: if true;
    }

    match /aiPredictions/{predId} {
      allow read, write: if true;
    }

    match /aiReports/{reportId} {
      allow read, write: if true;
    }
  }
}
